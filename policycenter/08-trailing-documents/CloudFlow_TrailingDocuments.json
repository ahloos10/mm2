{
  "name": "PC_TrailingDocuments",
  "trigger": { "type": "PowerApps", "inputs": { "PolicyNumber": "string", "DocumentName": "string", "NewStatus": "string", "ReceivedDate": "string", "Notes": "string" } },
  "steps": [
    { "step": 1, "action": "Run a flow built with Power Automate Desktop", "flow": "PAD_TrailingDocuments", "inputs": { "PolicyNumber": "@triggerBody()['PolicyNumber']", "DocumentName": "@triggerBody()['DocumentName']", "NewStatus": "@triggerBody()['NewStatus']", "ReceivedDate": "@triggerBody()['ReceivedDate']", "Notes": "@triggerBody()['Notes']", "PCBaseURL": "@parameters('PCBaseURL')" } },
    { "step": 2, "action": "Respond to PowerApps", "outputs": { "Result": "@outputs('Run_PAD_TrailingDocuments')?['body/Result']" } }
  ]
}
